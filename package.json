{
  "name": "skoolvault",
  "version": "0.1.0",
  "description": "Personal Skool community archive — courses, videos, files, feed",
  "type": "module",
  "bin": {
    "skoolvault": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "start": "node dist/cli.js",
    "skoolvault": "tsx src/cli.ts",
    "test:url": "tsx src/url.test.ts",
    "test:classroom": "tsx src/extractors/classroom.test.ts",
    "test:progress": "tsx src/progress.test.ts",
    "test:resume": "tsx src/lesson-resume.test.ts",
    "test:files": "tsx src/media/files.test.ts",
    "test:tiptap": "tsx src/tiptap.test.ts",
    "test:feed-sort": "tsx src/feed-sort.test.ts",
    "test": "npm run test:url && npm run test:classroom && npm run test:progress && npm run test:resume && npm run test:files && npm run test:tiptap && npm run test:feed-sort",
    "postinstall": "playwright install chromium"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "skool",
    "archive",
    "scraper",
    "offline",
    "backup"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^14.0.0",
    "playwright": "^1.63.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
